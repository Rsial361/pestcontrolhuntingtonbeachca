---
layout: layouts/base.njk
---

{% include "components/inner-hero.njk" %}
{% include "sections/trust-strip.njk" %}

<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Main Content Column (8 cols) -->
      <div class="lg:col-span-8 space-y-8">
        {% include "components/geo-takeaway-box.njk" %}

        <div class="prose prose-slate max-w-none prose-body-content">
          {{ content | safe }}
        </div>

        <div class="mt-12 pt-8 border-t border-slate-200">
          <h3 class="text-2xl font-black text-slate-900 mb-6">Frequently Asked Questions: {{ locationName or title }}</h3>
          {% include "sections/faq-accordion.njk" %}
        </div>
      </div>

      <!-- Right Sticky Dispatch Card (4 cols) -->
      <div class="lg:col-span-4">
        <div class="sticky top-28 space-y-6">
          
          <div class="bg-slate-900 text-white p-7 rounded-2xl border-2 border-amber-500 shadow-2xl space-y-5">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
                Active Field Units
              </span>
              <span class="text-xs text-slate-400 font-semibold">{{ locationName or site.city }}, CA</span>
            </div>

            <h3 class="text-xl font-black text-white leading-tight">Prompt Local Dispatch</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Connect directly with qualified pest control specialists serving {{ locationName or "your area" }}. On-site inspections and upfront pricing.
            </p>

            <a href="tel:{{ site.phoneRaw }}" class="flex items-center justify-center space-x-2 w-full py-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black text-lg shadow-xl shadow-amber-500/25 transition-all">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 12 19.79 19.79 0 0 1 1.06 3.39 2 2 0 0 1 3 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l.92.92z"/></svg>
              <span>Call {{ site.phone }}</span>
            </a>

            <div class="pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
              <div class="flex items-center"><span class="text-amber-400 mr-2 font-bold">✓</span> Direct phone dispatch</div>
              <div class="flex items-center"><span class="text-amber-400 mr-2 font-bold">✓</span> Upfront written estimates</div>
              <div class="flex items-center"><span class="text-amber-400 mr-2 font-bold">✓</span> Local neighborhood expertise</div>
              <div class="flex items-center"><span class="text-amber-400 mr-2 font-bold">✓</span> Clean-tech property protection</div>
            </div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-md">
            <h4 class="text-base font-black text-slate-900 mb-2">Request A Written Quote</h4>
            <p class="text-xs text-slate-600 mb-4">Complete our quick form to receive an estimate from our dispatch desk.</p>
            <a href="/contact/" class="block w-full text-center py-3 bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold text-sm rounded-xl transition-colors">
              Online Estimate Form →
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% include "sections/service-catalog.njk" %}
{% include "sections/geo-coverage.njk" %}
{% include "sections/exit-call-strip.njk" %}
