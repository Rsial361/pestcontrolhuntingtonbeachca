---
layout: layouts/base.njk
---

{% include "components/inner-hero.njk" %}
{% include "sections/trust-strip.njk" %}

<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Lead Capture Form (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600">Online Service Intake</span>
          <h2 class="text-3xl font-black text-slate-900 tracking-tight">Request A Written Project Estimate</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Fill out the form below to receive a prompt response from our local field dispatch desk. For urgent pest issues, call our direct phone hotline for immediate assistance.
          </p>
        </div>

        {% include "components/lead-form.njk" %}
      </div>

      <!-- Right Column: Direct Dispatch & NAP Hotline (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        
        <div class="bg-slate-900 text-white p-8 rounded-2xl border-2 border-amber-500 shadow-2xl space-y-6">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
              Immediate Phone Dispatch
            </span>
            <span class="text-xs text-slate-400 font-semibold">{{ site.city }}, {{ site.state }}</span>
          </div>

          <h3 class="text-2xl font-black text-white leading-tight">Direct Field Coordinator Desk</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Skip the forms. Speak immediately with our dispatch desk to log symptoms, evaluate urgent risks, and schedule a prompt on-site visit.
          </p>

          <a href="tel:{{ site.phoneRaw }}" class="flex items-center justify-center space-x-3 w-full py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black text-xl shadow-xl shadow-amber-500/25 transition-all">
            <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 12 19.79 19.79 0 0 1 1.06 3.39 2 2 0 0 1 3 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l.92.92z"/></svg>
            <span>Call {{ site.phone }}</span>
          </a>

          <div class="pt-6 border-t border-slate-800 space-y-3 text-xs text-slate-300">
            <div class="flex items-start">
              <span class="font-bold text-amber-400 w-24 flex-shrink-0">Dispatch Hours:</span>
              <span>{{ site.hours }}</span>
            </div>
            <div class="flex items-start">
              <span class="font-bold text-amber-400 w-24 flex-shrink-0">Office Address:</span>
              <span>{{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span>
            </div>
            <div class="flex items-start">
              <span class="font-bold text-amber-400 w-24 flex-shrink-0">Primary Area:</span>
              <span>Huntington Beach, Huntington Harbour, Sunset Beach, Bolsa Chica, Seacliff</span>
            </div>
          </div>
        </div>

        <!-- Diagnostic Protocol Card -->
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-3 text-xs text-slate-700">
          <h4 class="text-sm font-black text-slate-900 uppercase tracking-wider">What Happens After You Contact Us:</h4>
          <ol class="space-y-2 list-decimal list-inside leading-relaxed">
            <li><strong>Intake Triage:</strong> We record the pest species, property type, and acute symptoms.</li>
            <li><strong>Route Dispatch:</strong> An available local field technician is assigned to your location.</li>
            <li><strong>Diagnostic Inspection:</strong> Thorough visual evaluation of structural harborages.</li>
            <li><strong>Written Estimate:</strong> Clear itemized scope of work provided prior to treatment.</li>
          </ol>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- In-Depth Contact Copy -->
<section class="py-16 bg-slate-50 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="prose prose-slate max-w-none prose-body-content">
      {{ content | safe }}
    </div>
  </div>
</section>

{% include "sections/geo-coverage.njk" %}
{% include "sections/exit-call-strip.njk" %}
