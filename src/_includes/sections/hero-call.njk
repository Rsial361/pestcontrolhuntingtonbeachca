<!-- Master Hero Section: Strict Call CTA Only (No Form) -->
<section class="bg-slate-900 text-white pt-14 pb-20 border-b border-slate-800 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Value Column -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-4">
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-black tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>Prompt Local Dispatch • {{ site.city }}, {{ site.state }}</span>
          </div>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
            <span class="block relative pl-5 border-l-4 border-amber-500">
              {{ h1 or "Pest Control in Huntington Beach, CA" }}
            </span>
          </h1>
        </div>
        
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          {{ heroSubtitle or "Connect directly with experienced local pest control technicians in Huntington Beach. Targeted treatments for termites, rodents, Argentine ants, cockroaches, and common coastal pests with upfront written estimates." }}
        </p>
        
        <!-- Pay-Per-Call Compliant Trust Indicator Pills -->
        <div class="flex flex-wrap gap-4 pt-2 text-xs font-bold text-slate-300">
          <span class="flex items-center">
            <svg class="w-4 h-4 text-emerald-400 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Professional Technicians
          </span>
          <span class="flex items-center">
            <svg class="w-4 h-4 text-emerald-400 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Experienced Local Team
          </span>
          <span class="flex items-center">
            <svg class="w-4 h-4 text-emerald-400 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Clear Project Estimates
          </span>
          <span class="flex items-center">
            <svg class="w-4 h-4 text-emerald-400 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Prompt Regional Dispatch
          </span>
        </div>
      </div>
      
      <!-- Right Dispatch Call Card (Strict Call CTA Only — No Form in Hero) -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-slate-800 to-slate-900 p-6 sm:p-7 rounded-2xl shadow-2xl border-2 border-amber-500 text-white relative">
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
              Field Units Active Now
            </span>
            <span class="text-xs text-slate-400 font-semibold">{{ site.city }}, {{ site.state }}</span>
          </div>

          <h3 class="text-xl font-black text-white mb-1">Direct Field Dispatch Desk</h3>
          <p class="text-xs text-slate-300 mb-5">Connect directly with our local response crew. No automated phone trees or call centers.</p>

          <a href="tel:{{ site.phoneRaw }}" class="flex items-center justify-center space-x-3 w-full py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black text-lg sm:text-xl shadow-xl shadow-amber-500/25 transition-all transform hover:-translate-y-0.5">
            <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 12 19.79 19.79 0 0 1 1.06 3.39 2 2 0 0 1 3 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l.92.92z"/>
            </svg>
            <span>Call {{ site.phone }}</span>
          </a>

          <div class="mt-3 text-center">
            <p class="text-[11px] text-slate-400 font-medium">Prompt Phone Dispatch • Mon-Sun 7am-8pm</p>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-700/80 grid grid-cols-2 gap-2 text-xs text-slate-300">
            <div class="flex items-center"><span class="text-emerald-400 mr-2 font-bold">✓</span> Clear Estimates</div>
            <div class="flex items-center"><span class="text-emerald-400 mr-2 font-bold">✓</span> Prompt Arrival</div>
            <div class="flex items-center"><span class="text-emerald-400 mr-2 font-bold">✓</span> Targeted IPM Methods</div>
            <div class="flex items-center"><span class="text-emerald-400 mr-2 font-bold">✓</span> Clean-Tech Protocols</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
